# Python used by uv to create/sync the project virtual environment.
PYTHON_BIN=/opt/homebrew/opt/python@3.13/bin/python3.13

# Local project directories.
APPLE_AGENT_KIT_CACHE_DIR=.cache
APPLE_AGENT_KIT_ARTIFACTS_DIR=Artifacts

# Apple Core AI registry short name used when a command omits MODEL.
APPLE_AGENT_KIT_DEFAULT_MODEL=qwen3-1.7b

# Optional. Leave empty when using `hf auth login` / `apple-agent-kit login`.
# An environment token takes precedence over Hugging Face's locally stored token.
HF_TOKEN=
